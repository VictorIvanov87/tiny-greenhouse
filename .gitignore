# Node / React
node_modules/
dist/
build/
.cache/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Frontend / Backend outputs
frontend/node_modules/
frontend/dist/
backend/node_modules/
backend/dist/

# Environment files (generic patterns)
.env
.env.*
!.env.example

# Explicit env files with secrets — never track these
backend/.env
frontend/.env.local

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Hardware secrets (Wi-Fi, IoT Hub SAS tokens)
**/secrets.h
!**/secrets.example.h

# Credential files — never track these (Firebase admin keys, certs, private keys)
serviceAccount*.json
firebase-adminsdk*.json
*.pem
*.key
*.p12
id_rsa

# Firebase CLI hosting/deploy cache
.firebase/

# Local data & uploads (keep repo light)
data/timelapse/
data/raw/
uploads/
tmp/
