# ── Frontend environment ──────────────────────────────────
# These values are embedded in the client bundle at build time (VITE_ prefix).
# Firebase client keys are designed to be public, but keep .env.local out of
# version control to avoid leaking project identifiers unnecessarily.

VITE_API_BASE_URL=http://localhost:5173
VITE_APP_NAME=tiny-greenhouse

# ── Firebase client config ────────────────────────────────
# Obtain from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=                  # PUBLIC — but keep out of git to avoid exposing project ID
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
