# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AUTH_MODE=mock                          # REQUIRED: 'mock' for local dev only; production MUST set 'firebase' or the server will refuse to start
STORAGE_MODE=mock                      # 'mock' for in-memory, 'firestore' for Firestore persistence

# ── Firebase Admin SDK ── SECRET ──────────────────────────
# Obtain from Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key          # SECRET — full PEM key, do not commit

# ── Database ── SECRET ────────────────────────────────────
VECTOR_STORE=pgvector
DATABASE_URL=postgresql://user:pass@host:5432/postgres   # SECRET — connection string with credentials
DATABASE_SSL=require

# ── OpenAI ── SECRET ──────────────────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME                        # SECRET — OpenAI API key, do not commit

# ── Ollama (local) ────────────────────────────────────────
# Set LLM_PROVIDER=ollama / EMBED_PROVIDER=ollama to use a local Ollama instance.
# OLLAMA_BASE_URL defaults to http://localhost:11434/v1 if not set.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Azure OpenAI ── SECRET ────────────────────────────────
# Set LLM_PROVIDER=azure-openai / EMBED_PROVIDER=azure-openai to use Azure OpenAI.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=REPLACE_ME                          # SECRET
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-ada-002

# ── Embeddings & LLM ──────────────────────────────────────
# Supported: openai | ollama | azure-openai  (independent per role)
# When switching EMBED_PROVIDER or EMBED_MODEL, re-run: npm run rag:seed
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small         # ollama: nomic-embed-text | mxbai-embed-large
EMBED_DIMENSIONS=1536                      # nomic-embed-text: 768 | mxbai-embed-large: 1024
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini                     # ollama: llama3.2 | mistral | gemma3 | etc.

# ── RAG tuning ────────────────────────────────────────────
RAG_TOP_K=8
RAG_SCORE_FLOOR=0.20
RAG_DEBUG=false                         # Set to 'true' only for local debugging

# ── Assistant ─────────────────────────────────────────────
ASSIST_INPUT_LIMIT=800
ASSIST_MIN_QUERY_LEN=8

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW=3600                  # Window in seconds (default: 3600 = 1 hour)
RATE_LIMIT_MAX=30                       # Max assistant requests per window

# ── Crop defaults cache ──────────────────────────────────
CROP_DEFAULTS_TTL_MS=60000

# ── Soil moisture calibration ────────────────────────────
# Raw ADC readings that map to 0% / 100% moisture. Higher raw = drier soil.
# MUST match hardware/esp32-firmware/src/config.h (SOIL_RAW_DRY / SOIL_RAW_WET).
SOIL_RAW_DRY=19000                     # raw ADC reading in air (dry)
SOIL_RAW_WET=9500                      # raw ADC reading fully submerged (wet)

# ── Telemetry persistence ───────────────────────────────
TELEMETRY_RETENTION_DAYS=90            # Firestore TTL: auto-delete samples older than this
TELEMETRY_CACHE_TTL_MS=300000          # In-memory cache TTL for Firestore reads (default: 5 min)

# ── Azure Blob Storage ── SECRET ─────────────────────────
# Obtain from Azure Portal → Storage account → Access keys
# The container must be pre-created before running in firestore mode
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net  # SECRET
AZURE_STORAGE_CONTAINER=camera-images

# ── Azure IoT Hub ── SECRET ──────────────────────────────
# Set IOT_HUB_ENABLED=true to start consuming device telemetry from IoT Hub.
# Local dev can keep this false and use HTTP POST to /api/telemetry instead.
IOT_HUB_ENABLED=false
IOT_HUB_EVENT_HUB_CONNECTION_STRING=Endpoint=sb://...;SharedAccessKeyName=...;SharedAccessKey=...;EntityPath=...  # SECRET — built-in Event Hub-compatible endpoint
IOT_HUB_EVENT_HUB_NAME=your-iot-hub-name               # Usually the IoT Hub name
IOT_HUB_SERVICE_CONNECTION_STRING=HostName=...;SharedAccessKeyName=...;SharedAccessKey=...  # SECRET — for cloud-to-device commands
IOT_HUB_CHECKPOINT_CONTAINER=iot-checkpoints             # Container in the same storage account for Event Hub checkpointing
